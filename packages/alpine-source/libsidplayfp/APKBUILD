pkgname=libsidplayfp
pkgver=2.6.0
pkgrel=0
pkgdesc="Commodore 64 SID playback library"
url="https://github.com/libsidplayfp/libsidplayfp"
arch="all"
license="GPL-2.0-or-later"
makedepends="g++ make"
subpackages="$pkgname-dev"
source="libsidplayfp-$pkgver.tar.gz::https://archive.ubuntu.com/ubuntu/pool/universe/libs/libsidplayfp/libsidplayfp_$pkgver.orig.tar.gz"
options="!check" # UnitTest++ is optional upstream; SimplePlay tests real decoding.

build() {
	./configure --prefix=/usr --disable-static --without-gcrypt --without-exsid --without-hardsid
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
